# Fixture mode is only for local UI development; demo/default mode is dune.
VITE_DATA_MODE=dune
VITE_DUNE_API_BASE_URL=https://api.dune.com/api/v1
# A browser-visible, read-only Dune key; never use a privileged key here.
VITE_DUNE_API_KEY=
VITE_DUNE_KALSHI_QUERY_ID=
VITE_DUNE_POLYMARKET_QUERY_ID=

# Server-only OpenRouter key for /api/chart-analysis (chart-analysis Vite plugin).
# Must be OPENROUTER_API_KEY — not VITE_OPENROUTER_API_KEY; VITE_* попадает в браузерную сборку.
OPENROUTER_API_KEY=
